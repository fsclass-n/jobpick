# =====================================================================
# jobpick 환경 변수 예시
# - 로컬: 이 파일을 .env로 복사한 뒤 값을 채워 사용 (.env는 커밋 금지)
# - Render/Netlify: 각 대시보드의 Environment 설정에 직접 등록
# =====================================================================


# ---------------------------------------------------------------------
# [Frontend] React (Vite)
# VITE_ 접두사 변수는 브라우저 번들에 그대로 노출되므로 비밀값을 넣지 않습니다.
# ---------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
# 1단계 Netlify 데모: true (Mock 데이터·Mock 인증), 2단계 이후: false
VITE_USE_MOCK=true


# ---------------------------------------------------------------------
# [Backend] FastAPI
# ---------------------------------------------------------------------
APP_ENV=local
# TiDB Cloud 예: mysql+pymysql://USER:PASSWORD@gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/jobpick?ssl_verify_cert=true&ssl_verify_identity=true
# 비워 두면 로컬 SQLite 파일로 동작
DATABASE_URL=sqlite:///./jobpick.db
CORS_ORIGINS=http://localhost:5173,https://jobpick.netlify.app,https://jobpick.onrender.com

# JWT: USER_JWT_SECRET과 ADMIN_JWT_SECRET은 반드시 서로 다른 값 사용
# 생성 예: python -c "import secrets; print(secrets.token_urlsafe(64))"
USER_JWT_SECRET=
USER_JWT_EXPIRE_MINUTES=120
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRE_MINUTES=30

# 정식 관리자 로그인 보호
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_LOCK_MINUTES=15
# 정식 관리자 계정 (/admin/login 에서 입력, 일치 시 전체 CRUD 권한)
# 로컬 .env와 Render 대시보드에만 실제 값 등록, 이 파일·저장소·프런트 코드에는 값을 넣지 않음
# 비밀번호 생성 예: python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 체험 모드(샘플 데이터)는 서버 계정 없이 /api/auth/demo 로 동작하므로 테스트 계정 변수는 두지 않습니다.

# OAuth 2.0
# 백엔드 외부 주소: 제공자 콘솔에 {OAUTH_REDIRECT_BASE_URL}/api/auth/oauth/{google|naver|kakao}/callback 등록
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
# 소셜 로그인 완료 후 돌아갈 프런트엔드 주소
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# Storage (local | bucket)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
STORAGE_BUCKET_NAME=


# ---------------------------------------------------------------------
# [RPA] 채용 공고 수집 / OCR
# ---------------------------------------------------------------------
# 공공데이터포털(data.go.kr) 일반 인증키 (계정당 1개, API별 활용신청 필요 / 자동승인)
# - 인사혁신처_공공취업정보 조회 서비스(나라일터), 재정경제부_공공기관 채용정보 조회서비스(ALIO)
# - 행정안전부 한국지역정보개발원_채용정보 조회 서비스(지방공공기관 클린아이)
# requests의 params로 넘길 때는 Decoding 키 사용 (Encoding 키는 이중 인코딩됨)
DATA_GO_KR_API_KEY=
# 서울 열린데이터광장 인증키 (서울시 일자리플러스센터 채용정보 GetJobInfo, 민간 기업 공고)
SEOUL_OPEN_API_KEY=
# 고용24 Open API 인증키 (개인 신청 시 공채속보·채용행사·공채기업정보만 가능, 채용정보 목록/상세 불가)
WORK24_API_KEY=
# 사람인 채용정보 API access-key (승인제, 일 500회 제한, 출처 표기 필수)
SARAMIN_ACCESS_KEY=
RPA_HEADLESS=true
RPA_REQUEST_DELAY_SECONDS=2
# 실수집 스케줄 (cron 형식). 변경은 정식 관리자만 가능
RPA_SCHEDULE_CRON=0 6 * * *
OCR_LANG=kor+eng
