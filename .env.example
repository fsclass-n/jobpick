# =====================================================================
# jobpick 환경 변수 예시
#  - 로컬: 이 파일을 .env 로 복사해서 사용합니다.
#  - Render: [Render] 표시 항목은 대시보드 Environment 에 직접 등록합니다.
#  - Netlify: [Netlify] 표시 항목은 Site settings > Environment variables 에 등록합니다.
#  - [Secret] 표시 항목은 저장소에 실제 값을 절대 커밋하지 않습니다.
# =====================================================================

# ---------------------------------------------------------------------
# [Backend] 공통 실행 환경  ([Render] jobpick-api)
# ---------------------------------------------------------------------
APP_ENV=local
# 로컬 기본값은 SQLite. TiDB Cloud 사용 시 예) mysql+pymysql://USER:PASSWORD@gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/jobpick?ssl_ca=/etc/ssl/certs/ca-certificates.crt&ssl_verify_cert=true&ssl_verify_identity=true
DATABASE_URL=sqlite:///./storage/jobpick.db
# 업로드 파일(자소서/이력서 원본) 저장 경로
STORAGE_DIR=./storage
# CORS 허용 도메인 (쉼표 구분)
CORS_ORIGINS=http://localhost:5173,https://jobpick.netlify.app,https://jobpick.onrender.com
# OAuth 콜백 이후 돌아갈 프런트엔드 주소
FRONTEND_URL=http://localhost:5173
# 백엔드 외부 주소 (OAuth redirect_uri 생성용)
BACKEND_URL=http://localhost:8000
# 서버 시작 시 샘플 데이터 자동 생성 여부
SEED_ON_STARTUP=true

# ---------------------------------------------------------------------
# [Backend][Secret] 인증 - 일반 사용자 / 테스트 관리자(샌드박스)
#  * 32바이트 이상 임의 문자열 사용: python -c "import secrets;print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------
USER_JWT_SECRET=change-me-user-secret
USER_TOKEN_EXPIRE_MINUTES=720
SANDBOX_TOKEN_EXPIRE_MINUTES=120

# ---------------------------------------------------------------------
# [Backend][Secret] 인증 - 정식 관리자 (반드시 USER_JWT_SECRET 과 다른 값)
#  * 정식 관리자 계정 정보는 Render 대시보드에만 등록합니다. 여기에는 값을 적지 않습니다.
# ---------------------------------------------------------------------
ADMIN_JWT_SECRET=
ADMIN_TOKEN_EXPIRE_MINUTES=30
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
# 값이 있으면 정식 관리자 로그인 시 TOTP 2단계 인증을 요구합니다. (python -m backend.scripts.create_admin --totp 로 생성)
ADMIN_TOTP_SECRET=
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=15

# ---------------------------------------------------------------------
# [Backend] 테스트 계정 (개발/QA 용, 예시값 공개 가능)
# ---------------------------------------------------------------------
# 로그인 페이지의 테스트 계정 간편 로그인 버튼 노출 여부
ENABLE_TEST_ACCOUNTS=true
# 시드 시 대시보드 시연용 과거 수집/분석 이력 생성 여부 (trigger=seed 로 구분)
SEED_DEMO_HISTORY=true
TEST_USER_EMAIL=user@jobpick.test
TEST_USER_PASSWORD=Jobpick!2026
TEST_ADMIN_EMAIL=sandbox@jobpick.test
TEST_ADMIN_PASSWORD=Sandbox!2026

# ---------------------------------------------------------------------
# [Backend][Secret] 소셜 로그인 (OAuth 2.0)
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ---------------------------------------------------------------------
# [Backend][Secret] AI - Google Gemini (비어 있으면 규칙 기반 분석 엔진으로 대체)
# ---------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------
# [RPA][Secret] 공고 수집
# ---------------------------------------------------------------------
# 고용24(워크넷) 채용정보 Open API 인증키
WORKNET_API_KEY=
WORKNET_API_URL=http://openapi.work.go.kr/opi/opi/opia/wantedApi.do
# 크롤링 요청 간 대기(초)
CRAWL_DELAY_SECONDS=1.5
CRAWL_USER_AGENT=jobpick-rpa/1.0 (+https://jobpick.onrender.com)
# Tesseract OCR 실행 파일 경로 (Windows 예: C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=

# ---------------------------------------------------------------------
# [Frontend]  ([Netlify] 데모 / [Render] jobpick 프런트엔드)
#  * Vite 는 VITE_ 접두사 변수만 클라이언트에 노출합니다. 비밀값을 넣지 마세요.
# ---------------------------------------------------------------------
# 비워 두거나 VITE_USE_MOCK=true 이면 Mock 데이터/인증으로 동작 (Netlify 데모)
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK=false
